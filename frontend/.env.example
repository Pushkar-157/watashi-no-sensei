# Copy this file to ".env.local" (same folder) and edit the values.
# Both are optional: the defaults work when you run backend and frontend
# on the same computer as described in the README.

# >>> REPLACE IF NEEDED: where the Flask backend runs (development only). <<<
VITE_BACKEND_URL=http://localhost:5001

# >>> REPLACE IF NEEDED: only for a production build served from a different
# address than the backend, e.g. https://api.example.com (no trailing slash).
# Leave empty to call "/api" on the same address as the page.
VITE_API_BASE_URL=
