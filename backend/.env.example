# Copy this file to ".env" (same folder) and edit the values.
# The app works without a .env file: every value below has a default.

# >>> REPLACE IF NEEDED: where the Ollama server runs. <<<
# Default is your own computer. Change it only if Ollama runs on another
# machine or in Docker, e.g. http://192.168.1.50:11434
OLLAMA_HOST=http://localhost:11434

# >>> REPLACE IF NEEDED: the model that answers by default. <<<
# It must be installed first:  ollama pull llama3.2
# Run "ollama list" to see what you have. Users can also pick another
# installed model from the dropdown in the app.
OLLAMA_MODEL=llama3.2

# Seconds to wait for Ollama before giving up (the first reply can be slow
# while the model loads into memory).
OLLAMA_TIMEOUT=120

# Creativity: 0 = very predictable, 1 = more varied. 0.6 to 0.8 suits teaching.
OLLAMA_TEMPERATURE=0.7

# How many tokens of conversation the model can read at once.
OLLAMA_NUM_CTX=4096

# How many recent messages are sent to the model on each turn.
MAX_HISTORY_MESSAGES=20

# Where this Flask server listens. (Port 5000 is taken by AirPlay on macOS,
# so 5001 is the default.)
HOST=127.0.0.1
PORT=5001

# >>> REPLACE IF NEEDED: which website addresses may call this API. <<<
# Comma-separated. Only needed when the frontend is served from a different
# address than the Vite dev server (for example after deploying it).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to 1 to auto-reload the server when you edit Python files.
FLASK_DEBUG=0
